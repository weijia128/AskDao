/* 宣纸底，与首页/起念页一致 */
.page-shell > view.paper-veil {
  position: fixed;
  top: 0;
  left: 0;
  z-index: 0;
  width: 100vw;
  height: 100vh;
  pointer-events: none;
  background: linear-gradient(180deg, #f7f2e7 0%, #efe8d7 100%);
}

.title {
  margin: 32rpx 0;
  color: #23211c;
  font-size: 42rpx;
  font-family: "Songti SC", serif;
}

.history-swipe-row {
  position: relative;
  overflow: hidden;
  margin-bottom: 20rpx;
  border-radius: 24rpx;
}

.history-card-track {
  position: relative;
  transition: transform 0.18s ease;
  z-index: 2;
}

.history-swipe-row.open .history-card-track {
  transform: translateX(-154rpx);
}

.delete-action {
  position: absolute;
  top: 0;
  right: 0;
  bottom: 0;
  display: flex;
  align-items: center;
  justify-content: center;
  width: 154rpx;
  color: rgba(168, 60, 42, 0.85);
  background: rgba(168, 60, 42, 0.08);
  border-left: 1rpx solid rgba(168, 60, 42, 0.2);
  font-size: 28rpx;
  font-weight: 600;
  z-index: 1;
}

.history-card {
  padding: 28rpx;
  background: rgba(255, 253, 247, 0.72);
  border: 1rpx solid rgba(35, 33, 28, 0.1);
  border-radius: 24rpx;
}

.time {
  margin-bottom: 14rpx;
  color: #9a948a;
  font-size: 22rpx;
}

.line {
  color: #23211c;
  font-size: 30rpx;
  font-family: "Songti SC", serif;
  font-weight: 600;
}

.sub {
  margin-top: 12rpx;
  color: #6b675c;
  font-size: 24rpx;
}

.note {
  margin-top: 14rpx;
  color: #4a463e;
  font-size: 26rpx;
  line-height: 1.5;
}

.clear-all-button {
  margin-top: 40rpx;
  padding: 24rpx 32rpx;
  color: rgba(168, 60, 42, 0.9);
  font-size: 26rpx;
  text-align: center;
  border: 1rpx solid rgba(168, 60, 42, 0.4);
  border-radius: 999rpx;
}

.verify-summary {
  margin: -12rpx 0 28rpx;
  color: #7a6036;
  font-size: 26rpx;
}

.verify-tag {
  margin-left: 16rpx;
  padding: 4rpx 16rpx;
  color: #6b5636;
  border: 1rpx solid rgba(122, 96, 54, 0.32);
  border-radius: 999rpx;
  font-size: 22rpx;
}

.page-shell > canvas.verification-card-canvas {
  position: fixed;
  top: -9999px;
  left: -9999px;
  width: 375px;
  height: 560px;
}

.verify-card-button {
  margin: 32rpx auto 16rpx;
  padding: 20rpx 0;
  width: 320rpx;
  color: #4a3d24;
  border: 1rpx solid rgba(122, 96, 54, 0.36);
  border-radius: 999rpx;
  font-size: 27rpx;
  text-align: center;
}

/* 深色模式：玄墨色板，随系统切换 */
@media (prefers-color-scheme: dark) {
  .page-shell > view.paper-veil {
    background: linear-gradient(180deg, #141614 0%, #0c0e0c 100%);
  }

  .title {
    color: #f6efe2;
  }

  .delete-action {
    color: rgba(246, 239, 226, 0.72);
    background: rgba(15, 17, 15, 0.42);
    border-left-color: rgba(216, 174, 103, 0.16);
  }

  .history-card {
    background: rgba(255, 255, 255, 0.08);
    border-color: rgba(214, 167, 92, 0.22);
  }

  .time {
    color: rgba(246, 239, 226, 0.48);
  }

  .line {
    color: #f3db9a;
  }

  .sub {
    color: rgba(246, 239, 226, 0.64);
  }

  .note {
    color: rgba(243, 219, 154, 0.82);
  }

  .clear-all-button {
    color: rgba(224, 122, 102, 0.9);
    border-color: rgba(224, 122, 102, 0.4);
  }

  .verify-summary {
    color: rgba(232, 222, 198, 0.6);
  }

  .verify-tag {
    color: rgba(232, 222, 198, 0.72);
    border-color: rgba(214, 199, 160, 0.28);
  }

  .verify-card-button {
    color: #e8dec6;
    border-color: rgba(214, 199, 160, 0.3);
  }
}
