/* 归档卡底：档案袋铺底，纸纱罩层保字色 */
.page-shell > image.history-bg {
  position: fixed;
  top: 0;
  left: 0;
  z-index: 0;
  width: 100vw;
  height: 100vh;
  pointer-events: none;
}

.page-shell > view.paper-veil {
  position: fixed;
  top: 0;
  left: 0;
  z-index: 0;
  width: 100vw;
  height: 100vh;
  pointer-events: none;
  background: linear-gradient(180deg, rgba(247, 242, 231, 0.55) 0%, rgba(239, 232, 215, 0.65) 100%);
}

.title {
  margin: 32rpx 0;
  color: #23211c;
  font-size: 42rpx;
  font-family: "Songti SC", serif;
}

.history-swipe-row {
  position: relative;
  overflow: hidden;
  margin-bottom: 20rpx;
  border-radius: 24rpx;
}

.history-card-track {
  position: relative;
  transition: transform 0.18s ease;
  z-index: 2;
}

.history-swipe-row.open .history-card-track {
  transform: translateX(-154rpx);
}

/* 应验行多一枚「存卡」按钮，滑开位移加倍 */
.history-swipe-row.open.has-card-action .history-card-track {
  transform: translateX(-308rpx);
}

.card-action {
  position: absolute;
  top: 0;
  right: 154rpx;
  bottom: 0;
  display: flex;
  align-items: center;
  justify-content: center;
  width: 154rpx;
  color: rgba(122, 96, 54, 0.9);
  background: rgba(122, 96, 54, 0.08);
  border-left: 1rpx solid rgba(122, 96, 54, 0.2);
  font-size: 28rpx;
  font-weight: 600;
  z-index: 1;
}

.delete-action {
  position: absolute;
  top: 0;
  right: 0;
  bottom: 0;
  display: flex;
  align-items: center;
  justify-content: center;
  width: 154rpx;
  color: rgba(168, 60, 42, 0.85);
  background: rgba(168, 60, 42, 0.08);
  border-left: 1rpx solid rgba(168, 60, 42, 0.2);
  font-size: 28rpx;
  font-weight: 600;
  z-index: 1;
}

.history-card {
  padding: 28rpx;
  background: rgba(255, 253, 247, 0.72);
  border: 1rpx solid rgba(35, 33, 28, 0.1);
  border-radius: 24rpx;
}

.time {
  margin-bottom: 14rpx;
  color: #9a948a;
  font-size: 22rpx;
}

.line {
  color: #23211c;
  font-size: 30rpx;
  font-family: "Songti SC", serif;
  font-weight: 600;
}

.sub {
  margin-top: 12rpx;
  color: #6b675c;
  font-size: 24rpx;
}

.note {
  margin-top: 14rpx;
  color: #4a463e;
  font-size: 26rpx;
  line-height: 1.5;
}

.clear-all-button {
  margin-top: 40rpx;
  padding: 24rpx 32rpx;
  color: rgba(168, 60, 42, 0.9);
  font-size: 26rpx;
  text-align: center;
  border: 1rpx solid rgba(168, 60, 42, 0.4);
  border-radius: 999rpx;
}

.verify-summary {
  margin: -12rpx 0 28rpx;
  color: #7a6036;
  font-size: 26rpx;
}

.verify-tag {
  margin-left: 16rpx;
  padding: 4rpx 16rpx;
  color: #6b5636;
  border: 1rpx solid rgba(122, 96, 54, 0.32);
  border-radius: 999rpx;
  font-size: 22rpx;
}

.page-shell > canvas.verification-card-canvas {
  position: fixed;
  top: -9999px;
  left: -9999px;
  width: 375px;
  height: 560px;
}

.verify-card-button {
  margin: 32rpx auto 16rpx;
  padding: 20rpx 0;
  width: 320rpx;
  color: #4a3d24;
  border: 1rpx solid rgba(122, 96, 54, 0.36);
  border-radius: 999rpx;
  font-size: 27rpx;
  text-align: center;
}

/* 验课卡预览浮层：先看图，再决定存不存。
   需压过 app.wxss .page-shell > view 的 position:relative 规则，否则 fixed 失效、
   预览会掉进文档流末尾（页面最底部），与结果页 thought-mask 同一解法 */
.page-shell > view.card-preview-mask {
  position: fixed;
  top: 0;
  left: 0;
  z-index: 20;
  display: flex;
  align-items: center;
  justify-content: center;
  width: 100vw;
  height: 100vh;
  background: rgba(16, 16, 15, 0.72);
}

.card-preview {
  display: flex;
  flex-direction: column;
  align-items: center;
}

.card-preview-image {
  width: 620rpx;
  height: 926rpx;
  border-radius: 16rpx;
}

.card-preview-actions {
  display: flex;
  gap: 32rpx;
  margin-top: 40rpx;
}

.card-preview-save,
.card-preview-cancel {
  padding: 18rpx 0;
  width: 240rpx;
  font-size: 28rpx;
  text-align: center;
  border-radius: 999rpx;
}

.card-preview-save {
  color: #10100f;
  background: #f3db9a;
}

.card-preview-cancel {
  color: rgba(246, 239, 226, 0.85);
  border: 1rpx solid rgba(246, 239, 226, 0.4);
}

/* 应验卡的改状态入口：弱化成文字链，不与保存主按钮抢视觉 */
.card-preview-edit {
  margin-top: 28rpx;
  padding: 12rpx 24rpx;
  color: rgba(246, 239, 226, 0.6);
  font-size: 24rpx;
  line-height: 1.4;
}
