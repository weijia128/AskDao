<view class="page-shell history-page">
  <image class="history-bg" src="/assets/images/history-bg.jpg" mode="aspectFill"></image>
  <view class="paper-veil"></view>

  <view class="title">最近问道</view>
  <view class="verify-summary" wx:if="{{summary.settled}}">
    已验 {{summary.settled}} · 应验 {{summary.fulfilled}} · 应验率 {{summary.rate}}%
  </view>
  <view
    wx:for="{{records}}"
    wx:key="id"
    class="history-swipe-row {{openedRecordId == item.id ? 'open' : ''}} {{item.verification.status == 'fulfilled' ? 'has-card-action' : ''}}"
    data-id="{{item.id}}"
    bindtouchstart="handleTouchStart"
    bindtouchend="handleTouchEnd"
  >
    <view
      class="card-action"
      wx:if="{{item.verification.status == 'fulfilled'}}"
      data-id="{{item.id}}"
      catchtap="handleSaveRecordCard"
    >存卡</view>
    <view class="delete-action" data-id="{{item.id}}" catchtap="handleDeleteRecord">删除</view>
    <view class="history-card-track">
      <view class="history-card" data-id="{{item.id}}" bindtap="handleEditVerification">
        <view class="time">{{item.createdAtText}}</view>
        <view class="line">
          <text>{{item.rule_result.symbol}} · {{item.rule_result.grade}}</text>
          <text class="verify-tag" wx:if="{{item.verificationText}}">{{item.verificationText}}</text>
        </view>
        <view class="note" wx:if="{{item.thought_note}}">此念：{{item.thought_note}}</view>
        <view class="sub">{{item.interpretation.oracleText}}</view>
      </view>
    </view>
  </view>

  <view
    class="verify-card-button"
    wx:if="{{summary.settled}}"
    bindtap="handleSaveVerificationCard"
  >保存应验总览</view>

  <view
    class="clear-all-button"
    wx:if="{{records.length}}"
    bindtap="handleClearAllRecords"
  >清除全部记录</view>

  <view class="card-preview-mask" wx:if="{{showCardPreview}}">
    <view class="card-preview">
      <image class="card-preview-image" src="{{previewCardPath}}" mode="aspectFit" />
      <view class="card-preview-actions">
        <view class="card-preview-cancel" bindtap="handleCancelRecordCardPreview">取消</view>
        <view class="card-preview-save" bindtap="handleConfirmSaveRecordCard">保存到相册</view>
      </view>
      <view class="card-preview-edit" catchtap="handlePreviewEditVerification">改记验课</view>
    </view>
  </view>

  <canvas class="verification-card-canvas" canvas-id="verificationCardCanvas"></canvas>
</view>
