<view class="page-shell home-page">
  <view class="paper-veil"></view>

  <view class="date-header">
    <view class="date-ganzhi" wx:if="{{almanac.ganzhiText}}">{{almanac.ganzhiText}}</view>
    <view class="date-lunar">
      {{almanac.lunarText || almanac.solarText}} · {{almanac.weekdayText}}
    </view>
  </view>

  <view class="verify-panel" wx:if="{{dueRecord}}">
    <view class="panel-caption">
      <view class="caption-line"></view>
      <view class="caption-text">验课</view>
      <view class="caption-line"></view>
    </view>
    <view class="verify-time">{{dueRecordTimeText}}，你曾问过一事</view>
    <view class="verify-note">此念：{{dueRecord.thought_note}}</view>
    <view class="verify-symbol">
      当时得 {{dueRecord.rule_result.symbol}} · {{dueRecord.rule_result.grade}}
    </view>
    <view class="verify-actions">
      <view class="verify-action" data-action="fulfilled" bindtap="handleVerify">应验</view>
      <view class="verify-action" data-action="unfulfilled" bindtap="handleVerify">未应验</view>
      <view class="verify-action muted" data-action="defer" bindtap="handleVerify">尚未分晓</view>
    </view>
  </view>

  <view class="hero">
    <view class="taiji-entry" hover-class="taiji-entry-active" bindtap="handleStart">
      <view class="seal-ring">
        <image class="bagua-image" src="/assets/images/bagua-taiji.png" mode="aspectFit"></image>
      </view>
      <view class="entry-button">问道</view>
    </view>
    <view class="ritual-limit">{{dailyLimitText}}</view>
  </view>

  <view class="rules-panel">
    <view class="panel-caption">
      <view class="caption-line"></view>
      <view class="caption-text">占前须知</view>
      <view class="caption-line"></view>
    </view>
    <view wx:for="{{ritualRules}}" wx:key="title" class="rule-row">
      <view class="rule-title">{{item.title}}</view>
      <view class="rule-text">{{item.text}}</view>
    </view>
  </view>

  <view class="almanac-panel">
    <view class="panel-caption">
      <view class="caption-line"></view>
      <view class="caption-text">今日黄历</view>
      <view class="caption-line"></view>
    </view>
    <view class="almanac-meta" wx:if="{{almanac.zodiacText || almanac.chongShaText}}">
      {{almanac.solarText}} · {{almanac.zodiacText}} · {{almanac.chongShaText}}
    </view>

    <view class="almanac-row" wx:if="{{almanac.yi.length}}">
      <view class="almanac-label">宜</view>
      <view class="almanac-items">
        <text wx:for="{{almanac.yi}}" wx:key="*this" class="almanac-item">{{item}}</text>
      </view>
    </view>

    <view class="almanac-row" wx:if="{{almanac.ji.length}}">
      <view class="almanac-label muted">忌</view>
      <view class="almanac-items">
        <text wx:for="{{almanac.ji}}" wx:key="*this" class="almanac-item muted">{{item}}</text>
      </view>
    </view>

    <view class="almanac-update-notice" wx:if="{{almanac.noticeText}}">{{almanac.noticeText}}</view>

    <view class="almanac-footer">
      <view class="almanac-note" wx:if="{{!almanac.noticeText}}">宜忌据 6tail/lunar-javascript 生成，仅供民俗参考。</view>
      <view class="vermillion-seal">问</view>
    </view>
  </view>

  <view class="history-entry">
    <view class="history-link" bindtap="handleOpenHistory">问道记录</view>
  </view>
</view>
