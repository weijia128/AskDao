.ritual-page {
  display: flex;
  flex-direction: column;
}

/* 起念底：档案图铺底，纸纱罩层保字色 */
.page-shell > image.ritual-bg {
  position: fixed;
  top: 0;
  left: 0;
  z-index: 0;
  width: 100vw;
  height: 100vh;
  pointer-events: none;
}

.page-shell > view.paper-veil {
  position: fixed;
  top: 0;
  left: 0;
  z-index: 0;
  width: 100vw;
  height: 100vh;
  pointer-events: none;
  background: linear-gradient(180deg, rgba(247, 242, 231, 0.55) 0%, rgba(239, 232, 215, 0.65) 100%);
}

/* 报头：一条发丝线题记 + 一行三不占小注，全页只此一处双线装饰 */
.ritual-masthead {
  margin-top: 48rpx;
}

.ritual-caption {
  display: flex;
  align-items: center;
}

.panel-caption {
  display: flex;
  align-items: center;
}

.caption-line {
  flex: 1;
  height: 1rpx;
  background: rgba(35, 33, 28, 0.14);
}

.caption-text {
  padding: 0 24rpx;
  color: #6b675c;
  font-size: 24rpx;
  font-family: "Songti SC", serif;
  letter-spacing: 8rpx;
}

/* 三不占：题记下的小注，不再重复横线，靠字号与浓淡分层 */
.rules-row {
  display: flex;
  align-items: center;
  justify-content: center;
  margin-top: 18rpx;
}

.rules-text {
  color: #8b8579;
  font-size: 22rpx;
  font-family: "Songti SC", serif;
  letter-spacing: 3rpx;
  white-space: nowrap;
}

.ritual-hero {
  display: flex;
  flex-direction: column;
  align-items: center;
  margin-top: 64rpx;
}

.ritual-action {
  position: relative;
  display: flex;
  align-items: center;
  justify-content: center;
  width: 336rpx;
  height: 336rpx;
  transition: transform 0.18s ease, opacity 0.18s ease;
}

.ritual-action-hover {
  opacity: 0.75;
  transform: scale(0.98);
}

.spinning-ring {
  position: absolute;
  top: 50%;
  left: 50%;
  z-index: 3;
  width: 328rpx;
  height: 328rpx;
  margin-top: -164rpx;
  margin-left: -164rpx;
  border: 3rpx solid rgba(35, 33, 28, 0.12);
  border-top-color: #a83c2a;
  border-radius: 50%;
  animation: spin 1s linear infinite;
}

@keyframes spin {
  from {
    transform: rotate(0deg);
  }

  to {
    transform: rotate(360deg);
  }
}

@media (prefers-reduced-motion: reduce) {
  .spinning-ring {
    animation: none;
  }

  .circle::before,
  .circle::after {
    animation: none;
    opacity: 0;
  }

  .circle {
    animation: none;
  }
}

.circle {
  position: absolute;
  top: 50%;
  left: 50%;
  z-index: 4;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  width: 280rpx;
  height: 280rpx;
  margin-top: -140rpx;
  margin-left: -140rpx;
  border: 2rpx solid rgba(35, 33, 28, 0.5);
  border-radius: 50%;
  transition: border-color 0.2s ease;
  /* 主体自身也起伏，可点提示才不至于全压在外圈一条线上 */
  animation: circle-pulse 2.4s ease-in-out infinite;
}

@keyframes circle-pulse {
  0%,
  100% {
    transform: scale(1);
  }

  50% {
    transform: scale(1.03);
  }
}

/* 起课中定住：此时圆心在走数字，起伏会读成抖动 */
.active .circle {
  border-color: rgba(35, 33, 28, 0.72);
  animation: none;
}

/* 涟漪：与首页同一套可点提示；起课时让位给旋转环，避免两圈动效打架。
   两圈错开半个周期，避免单圈淡出后出现「没有任何动静」的空档。 */
.circle::before,
.circle::after {
  content: '';
  position: absolute;
  top: -3rpx;
  right: -3rpx;
  bottom: -3rpx;
  left: -3rpx;
  border: 3rpx solid rgba(35, 33, 28, 0.7);
  border-radius: 50%;
  animation: circle-ripple 2.4s ease-out infinite;
}

/* 负延迟：进页面即处于周期中段，不必等 1.2s 才补上第二圈 */
.circle::before {
  animation-delay: -1.2s;
}

.active .circle::before,
.active .circle::after {
  animation: none;
  opacity: 0;
}

@keyframes circle-ripple {
  0% {
    opacity: 0.7;
    transform: scale(1);
  }

  100% {
    opacity: 0;
    transform: scale(1.32);
  }
}

.inner {
  color: #23211c;
  font-size: 56rpx;
  font-family: "Songti SC", serif;
  font-weight: 700;
  letter-spacing: 10rpx;
}

.count-symbol {
  color: #23211c;
  font-size: 44rpx;
  font-family: "Songti SC", serif;
  font-weight: 700;
  letter-spacing: 6rpx;
}

.title {
  margin-top: 40rpx;
  color: #23211c;
  font-size: 38rpx;
  font-family: "Songti SC", serif;
  letter-spacing: 6rpx;
}

/* 提示语比正文淡、但要比页脚小注重，否则读成脚注而非可点处 */
.action-hint {
  margin-top: 14rpx;
  color: #6b675c;
  font-size: 24rpx;
  letter-spacing: 2rpx;
}

/* 此念手札：成框的书写格，与页面的装饰横线区分开，明确是可落笔处 */
.note-entry {
  margin-top: 56rpx;
  padding: 22rpx 24rpx 20rpx;
  border: 1rpx solid rgba(35, 33, 28, 0.16);
  border-radius: 8rpx;
  background: rgba(255, 252, 245, 0.5);
  transition: border-color 0.2s ease, background-color 0.2s ease;
}

.note-entry.focused {
  border-color: rgba(35, 33, 28, 0.42);
  background: rgba(255, 252, 245, 0.85);
}

.note-head {
  display: flex;
  align-items: baseline;
  justify-content: space-between;
}

.note-label {
  color: #6b675c;
  font-size: 24rpx;
  font-family: "Songti SC", serif;
  letter-spacing: 6rpx;
}

.note-meta {
  color: #a9a296;
  font-size: 20rpx;
}

.note-input {
  width: 100%;
  min-height: 44rpx;
  margin-top: 14rpx;
  color: #23211c;
  font-size: 28rpx;
  line-height: 1.6;
}

.note-placeholder {
  color: #b5aea2;
  font-size: 26rpx;
  font-family: "Songti SC", serif;
}

.guidance-panel {
  margin-top: 56rpx;
  padding-bottom: 24rpx;
}

.guidance-lead {
  margin-top: 32rpx;
  color: #3a382f;
  font-size: 30rpx;
  font-family: "Songti SC", serif;
  line-height: 1.6;
  letter-spacing: 1rpx;
}

/* 宜问 / 不宜问：左侧短栏对齐两条例句，朱色为宜、淡墨为忌 */
.guidance-examples {
  display: flex;
  flex-direction: column;
  margin-top: 26rpx;
}

.guidance-line {
  padding-left: 20rpx;
  border-left: 3rpx solid transparent;
  font-size: 26rpx;
  font-family: "Songti SC", serif;
  line-height: 1.6;
}

.guidance-line + .guidance-line {
  margin-top: 18rpx;
}

.guidance-line.positive {
  color: #3a382f;
  border-left-color: rgba(168, 60, 42, 0.55);
}

.guidance-line.negative {
  color: #9a948a;
  border-left-color: rgba(35, 33, 28, 0.14);
}

.guidance-note {
  margin-top: 32rpx;
  color: #b0a99d;
  font-size: 23rpx;
  font-family: "Songti SC", serif;
  line-height: 1.6;
}
