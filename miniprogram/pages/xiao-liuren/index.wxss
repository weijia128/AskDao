.ritual-page {
  display: flex;
  flex-direction: column;
}

/* 宣纸底：宋人尺牍，无光晕、无投影 */
.page-shell > view.paper-veil {
  position: fixed;
  top: 0;
  left: 0;
  z-index: 0;
  width: 100vw;
  height: 100vh;
  pointer-events: none;
  background: linear-gradient(180deg, #f7f2e7 0%, #efe8d7 100%);
}

.ritual-caption {
  display: flex;
  align-items: center;
  margin-top: 56rpx;
}

.panel-caption {
  display: flex;
  align-items: center;
}

.caption-line {
  flex: 1;
  height: 1rpx;
  background: rgba(35, 33, 28, 0.14);
}

.caption-text {
  padding: 0 24rpx;
  color: #6b675c;
  font-size: 24rpx;
  font-family: "Songti SC", serif;
  letter-spacing: 8rpx;
}

.ritual-hero {
  display: flex;
  flex-direction: column;
  align-items: center;
  margin-top: 72rpx;
}

/* 三不占：与遇事不决同款发丝横线行，一行收束 */
.rules-row {
  display: flex;
  align-items: center;
  margin-top: 28rpx;
}

.rules-text {
  padding: 0 24rpx;
  color: #4a463e;
  font-size: 26rpx;
  font-family: "Songti SC", serif;
  font-weight: 600;
  letter-spacing: 4rpx;
  white-space: nowrap;
}

.ritual-action {
  position: relative;
  display: flex;
  align-items: center;
  justify-content: center;
  width: 336rpx;
  height: 336rpx;
  transition: transform 0.18s ease, opacity 0.18s ease;
}

.ritual-action-hover {
  opacity: 0.75;
  transform: scale(0.98);
}

.spinning-ring {
  position: absolute;
  top: 50%;
  left: 50%;
  z-index: 3;
  width: 328rpx;
  height: 328rpx;
  margin-top: -164rpx;
  margin-left: -164rpx;
  border: 3rpx solid rgba(35, 33, 28, 0.12);
  border-top-color: #a83c2a;
  border-radius: 50%;
  animation: spin 1s linear infinite;
}

@keyframes spin {
  from {
    transform: rotate(0deg);
  }

  to {
    transform: rotate(360deg);
  }
}

@media (prefers-reduced-motion: reduce) {
  .spinning-ring {
    animation: none;
  }
}

.circle {
  position: absolute;
  top: 50%;
  left: 50%;
  z-index: 4;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  width: 280rpx;
  height: 280rpx;
  margin-top: -140rpx;
  margin-left: -140rpx;
  border: 2rpx solid rgba(35, 33, 28, 0.5);
  border-radius: 50%;
  transition: border-color 0.2s ease;
}

.active .circle {
  border-color: rgba(35, 33, 28, 0.72);
}

.inner {
  color: #23211c;
  font-size: 56rpx;
  font-family: "Songti SC", serif;
  font-weight: 700;
  letter-spacing: 10rpx;
}

.count-symbol {
  color: #23211c;
  font-size: 44rpx;
  font-family: "Songti SC", serif;
  font-weight: 700;
  letter-spacing: 6rpx;
}

.title {
  margin-top: 44rpx;
  color: #23211c;
  font-size: 40rpx;
  font-family: "Songti SC", serif;
  letter-spacing: 4rpx;
}

/* 此念手札：一条发丝线下划书写行，聚焦时线加深、显示字数与隐私说明 */
.note-entry {
  margin-top: 48rpx;
  padding-bottom: 14rpx;
  border-bottom: 1rpx solid rgba(35, 33, 28, 0.18);
  transition: border-color 0.2s ease;
}

.note-entry.focused {
  border-bottom-color: rgba(35, 33, 28, 0.5);
}

.note-label {
  color: #6b675c;
  font-size: 24rpx;
  font-family: "Songti SC", serif;
  letter-spacing: 6rpx;
}

.note-input {
  width: 100%;
  min-height: 44rpx;
  margin-top: 10rpx;
  color: #23211c;
  font-size: 28rpx;
  line-height: 1.5;
}

.note-placeholder {
  color: #b5aea2;
  font-size: 26rpx;
}

.note-meta {
  margin-top: 8rpx;
  color: #b5aea2;
  font-size: 20rpx;
  text-align: right;
}

.guidance-panel {
  margin-top: 56rpx;
}

.guidance-lead {
  margin-top: 30rpx;
  color: #23211c;
  font-size: 28rpx;
  line-height: 1.6;
}

.guidance-line {
  margin-top: 20rpx;
  font-size: 26rpx;
  line-height: 1.5;
}

.guidance-line.positive {
  color: #23211c;
}

.guidance-line.negative {
  color: #9a948a;
}

.guidance-note {
  margin-top: 30rpx;
  color: #b5aea2;
  font-size: 24rpx;
  line-height: 1.5;
}

/* 深色模式：玄墨色板，随系统切换 */
@media (prefers-color-scheme: dark) {
  .page-shell > view.paper-veil {
    background: linear-gradient(180deg, #141614 0%, #0c0e0c 100%);
  }

  .caption-line {
    background: rgba(216, 174, 103, 0.22);
  }

  .caption-text {
    color: rgba(216, 174, 103, 0.78);
  }

  .rules-text {
    color: rgba(246, 239, 226, 0.85);
  }

  .spinning-ring {
    border-color: rgba(216, 174, 103, 0.14);
    border-top-color: #f3db9a;
  }

  .circle {
    border-color: rgba(216, 174, 103, 0.55);
  }

  .active .circle {
    border-color: rgba(243, 219, 154, 0.78);
  }

  .inner {
    color: #f3db9a;
  }

  .count-symbol {
    color: #f3db9a;
  }

  .title {
    color: #f6efe2;
  }

  .note-entry {
    border-bottom-color: rgba(216, 174, 103, 0.28);
  }

  .note-entry.focused {
    border-bottom-color: rgba(216, 174, 103, 0.6);
  }

  .note-label {
    color: rgba(216, 174, 103, 0.78);
  }

  .note-input {
    color: rgba(246, 239, 226, 0.88);
  }

  .note-placeholder {
    color: rgba(246, 239, 226, 0.35);
  }

  .note-meta {
    color: rgba(246, 239, 226, 0.35);
  }

  .guidance-lead {
    color: rgba(246, 239, 226, 0.78);
  }

  .guidance-line.positive {
    color: rgba(243, 219, 154, 0.88);
  }

  .guidance-line.negative {
    color: rgba(246, 239, 226, 0.5);
  }

  .guidance-note {
    color: rgba(246, 239, 226, 0.4);
  }
}
