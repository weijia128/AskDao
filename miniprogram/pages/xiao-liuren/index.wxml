<view class="page-shell ritual-page">
  <view class="paper-veil"></view>

  <view class="ritual-caption">
    <view class="caption-line"></view>
    <view class="caption-text">遇事不决，六壬决断</view>
    <view class="caption-line"></view>
  </view>

  <view class="rules-row">
    <view class="caption-line"></view>
    <view class="rules-text">不诚不占 · 不疑不占 · 不义不占</view>
    <view class="caption-line"></view>
  </view>

  <view class="ritual-hero">
    <view class="ritual-action {{isDivining ? 'active' : ''}}" hover-class="ritual-action-hover" bindtap="handleDivine">
      <view class="spinning-ring" wx:if="{{isDivining}}"></view>
      <view class="circle">
        <view class="count-symbol" wx:if="{{isDivining && countSymbol}}">{{countSymbol}}</view>
        <view class="inner" wx:else>{{isDivining ? '起课中' : '起念'}}</view>
      </view>
    </view>
    <view class="title">心中默念所想</view>
  </view>

  <view class="note-entry {{noteFocused ? 'focused' : ''}}">
    <view class="note-label">此念</view>
    <textarea
      class="note-input"
      value="{{questionText}}"
      maxlength="60"
      placeholder="心中所问，可落笔于此（便于事后验证，仅本机可见）"
      placeholder-class="note-placeholder"
      auto-height
      confirm-type="done"
      bindinput="handleNoteInput"
      bindfocus="handleNoteFocus"
      bindblur="handleNoteBlur"
    ></textarea>
    <view class="note-meta" wx:if="{{noteFocused}}">{{questionText.length}}/60 · 仅存本机，不上传</view>
  </view>

  <view class="guidance-panel">
    <view class="panel-caption">
      <view class="caption-line"></view>
      <view class="caption-text">如何问</view>
      <view class="caption-line"></view>
    </view>
    <view class="guidance-lead">请在心中默问一件小事，一个方向。</view>
    <view class="guidance-line positive">宜问：这件事今天推进，是否合适？</view>
    <view class="guidance-line negative">不宜问：我应该怎么办？</view>
    <view class="guidance-note">不以玩笑试探，不反复追问同一事。</view>
  </view>
</view>
