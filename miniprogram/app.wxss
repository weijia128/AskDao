page {
  min-height: 100vh;
  color: #f6efe2;
  background: #111310;
  font-family: -apple-system, BlinkMacSystemFont, "PingFang SC", "Helvetica Neue", sans-serif;
}

.page-shell {
  position: relative;
  overflow-x: hidden;
  overflow-y: visible;
  min-height: 100vh;
  padding: 40rpx 32rpx;
  box-sizing: border-box;
  background: #111310;
}

.page-shell > view,
.page-shell > canvas {
  position: relative;
  z-index: 1;
}

.primary-button {
  display: flex;
  align-items: center;
  justify-content: center;
  min-height: 96rpx;
  padding: 0 32rpx;
  color: #17110a;
  background: linear-gradient(135deg, #d8ae67, #f3db9a);
  border-radius: 999rpx;
  font-weight: 600;
}
