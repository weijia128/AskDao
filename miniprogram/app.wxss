page {
  min-height: 100vh;
  color: #f6efe2;
  background: #10100f;
  font-family: -apple-system, BlinkMacSystemFont, "PingFang SC", "Helvetica Neue", sans-serif;
}

.page-shell {
  min-height: 100vh;
  padding: 40rpx 32rpx;
  box-sizing: border-box;
}

.glass-card {
  background: rgba(255, 255, 255, 0.1);
  border: 1rpx solid rgba(214, 167, 92, 0.24);
  border-radius: 24rpx;
  box-shadow: 0 24rpx 80rpx rgba(0, 0, 0, 0.24);
}

.primary-button {
  display: flex;
  align-items: center;
  justify-content: center;
  min-height: 96rpx;
  padding: 0 32rpx;
  color: #17110a;
  background: linear-gradient(135deg, #d8ae67, #f3db9a);
  border-radius: 999rpx;
  font-weight: 600;
}
